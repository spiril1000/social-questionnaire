# Copy to .env and fill in. Used by docker-compose.yml (env_file).

# The login for /admin (HTTP Basic auth). Required: without it the admin refuses to open.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Optional: every submission is POSTed here as JSON (e.g. an n8n Webhook node). Empty = off.
N8N_WEBHOOK_URL=

# Reverse proxies in front of the app whose X-Forwarded-For header can be trusted (1 = one proxy,
# e.g. nginx/Traefik/Caddy). Set to 0 if the app is reachable directly, without a proxy.
PROXY_COUNT=1

# The user/group the app runs as and that owns /config and /data (match your host user).
PUID=1000
PGID=1000

# Turns on the admin login. Already true in the image; only set false for local testing.
# PRODUCTION=true
